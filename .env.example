# Copy this file to .env and fill in your values. Never commit .env itself.

KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# Always start with this set to true. Only switch to false once you've
# validated the strategy in paper mode and understand every line of
# market_maker.py and risk_manager.py.
KALSHI_PAPER_TRADING=true

# Comma-separated tickers to quote on startup (can also be changed from the
# dashboard). Pick ones with real 24h volume — run `python scanner.py`.
KALSHI_WATCHED_TICKERS=
