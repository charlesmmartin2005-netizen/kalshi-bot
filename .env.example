# Copy this file to .env and fill in your values. Never commit .env itself.

KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# Kalshi's demo environment (mock funds, needs its own key):
# KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
# KALSHI_WS_URL=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2

# Always start with this set to true. false means real orders and real money:
# read "Going live" in README.md first.
KALSHI_PAPER_TRADING=true

# Live only: what went into the account, so the dashboard can show profit since
# then. Update it if you deposit or withdraw.
KALSHI_LIVE_START_USD=50

# Comma-separated tickers to quote on startup (can also be changed from the
# dashboard). Pick ones with real 24h volume — run `python scanner.py`.
KALSHI_WATCHED_TICKERS=
